<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- OPTIONS WINDOW (form of the wizard) -->
    <record id="view_stock_ageing_wizard_form" model="ir.ui.view">
        <field name="name">stock.ageing.wizard.form</field>
        <field name="model">stock.ageing.wizard</field>
        <field name="arch" type="xml">
            <form string="Ageing Products">
                <group>
                    <field name="output_type" widget="radio"/>
                    <field name="warehouse_ids" widget="many2many_tags"/>
                    <field name="recompute"/>
                    <field name="last_refresh"/>
                </group>
                <footer>
                    <!-- calls StockAgeingWizard.action_generate() -->
                    <button name="action_generate" type="object" string="Generate" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action that shows the wizard as a popup (target=new) -->
    <record id="action_stock_ageing_wizard" model="ir.actions.act_window">
        <field name="name">Ageing Products</field>
        <field name="res_model">stock.ageing.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- MENU: Inventory > Reporting > Ageing Products.
         Only Inventory users (warehouse users) and managers (admin) see it.
         It lives in this file because it needs the action defined above. -->
    <menuitem id="menu_stock_ageing_report"
              name="Ageing Products"
              parent="stock.menu_warehouse_report"
              action="action_stock_ageing_wizard"
              groups="stock.group_stock_user"
              sequence="90"/>

    <!-- NIGHTLY JOB: rebuilds the snapshot once a day so "reuse last snapshot"
         is always reasonably fresh. -->
    <record id="cron_stock_ageing_refresh" model="ir.cron">
        <field name="name">Stock Ageing: refresh snapshot</field>
        <field name="model_id" ref="model_stock_ageing_report"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>

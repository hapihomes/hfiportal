<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        NOTE: this Odoo build's res.groups model has no 'category_id' field
        (the classic module-category grouping used by the Users form's
        Access Rights tab isn't available here), so these groups aren't
        tagged with a category. They still work fully for access control and
        menu visibility (see ph_payroll_menus.xml); to assign them to a
        user, use the group's own "Users" tab (Settings > Technical > Users >
        Groups) rather than looking for a "PH Payroll" section on the user
        form.
    -->
    <record id="group_ph_payroll_user" model="res.groups">
        <field name="name">Payroll Officer</field>
        <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="group_ph_payroll_manager" model="res.groups">
        <field name="name">Payroll Administrator</field>
        <field name="implied_ids" eval="[(4, ref('group_ph_payroll_user')), (4, ref('hr.group_hr_manager'))]"/>
    </record>

    <!-- Multi-company record rules -->
    <record id="rule_ph_sss_table_company" model="ir.rule">
        <field name="name">PH SSS Table: multi-company</field>
        <field name="model_id" ref="model_ph_sss_table"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_ph_philhealth_config_company" model="ir.rule">
        <field name="name">PH PhilHealth Config: multi-company</field>
        <field name="model_id" ref="model_ph_philhealth_config"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_ph_hdmf_table_company" model="ir.rule">
        <field name="name">PH HDMF Table: multi-company</field>
        <field name="model_id" ref="model_ph_hdmf_table"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_hr_employee_loan_company" model="ir.rule">
        <field name="name">Employee Loan: multi-company</field>
        <field name="model_id" ref="model_hr_employee_loan"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>

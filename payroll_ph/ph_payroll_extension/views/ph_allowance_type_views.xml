<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ph_allowance_type_list" model="ir.ui.view">
        <field name="name">ph.allowance.type.list</field>
        <field name="model">ph.allowance.type</field>
        <field name="arch" type="xml">
            <list string="Allowance Types">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="is_taxable"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_ph_allowance_type_form" model="ir.ui.view">
        <field name="name">ph.allowance.type.form</field>
        <field name="model">ph.allowance.type</field>
        <field name="arch" type="xml">
            <form string="Allowance Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="is_taxable"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ph_allowance_type" model="ir.actions.act_window">
        <field name="name">Allowance Types</field>
        <field name="res_model">ph.allowance.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>

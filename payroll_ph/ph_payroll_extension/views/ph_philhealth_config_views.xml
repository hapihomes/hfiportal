<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ph_philhealth_config_list" model="ir.ui.view">
        <field name="name">ph.philhealth.config.list</field>
        <field name="model">ph.philhealth.config</field>
        <field name="arch" type="xml">
            <list string="PhilHealth Configuration" editable="bottom">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="premium_rate"/>
                <field name="ee_share_rate"/>
                <field name="salary_floor"/>
                <field name="salary_ceiling"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_ph_philhealth_config_form" model="ir.ui.view">
        <field name="name">ph.philhealth.config.form</field>
        <field name="model">ph.philhealth.config</field>
        <field name="arch" type="xml">
            <form string="PhilHealth Configuration">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="premium_rate"/>
                            <field name="ee_share_rate"/>
                            <field name="salary_floor"/>
                            <field name="salary_ceiling"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ph_philhealth_config" model="ir.actions.act_window">
        <field name="name">PhilHealth Configuration</field>
        <field name="res_model">ph.philhealth.config</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_help">Define a PhilHealth premium rate</p>
            <p>Configure the total premium rate, employee/employer split and the monthly salary floor/ceiling.</p>
        </field>
    </record>

</odoo>

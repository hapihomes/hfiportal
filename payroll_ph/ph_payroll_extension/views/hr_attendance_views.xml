<?xml version="1.0" encoding="utf-8"?>
<!--
    A standalone (not inherited) list view + action for reviewing late
    check-ins and the deduction that will be pulled into payroll. Kept
    self-contained rather than extending hr_attendance's own list view,
    since that base view's exact structure isn't guaranteed across Odoo
    versions/customizations (see the same reasoning in ph_config.py).
-->
<odoo>

    <record id="view_hr_attendance_ph_late_list" model="ir.ui.view">
        <field name="name">hr.attendance.ph.late.list</field>
        <field name="model">hr.attendance</field>
        <field name="arch" type="xml">
            <list string="Late Attendance" default_order="check_in desc" create="false">
                <field name="employee_id"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="ph_scheduled_time_in" widget="float_time"/>
                <field name="ph_late_minutes" sum="Total Late Minutes"/>
                <field name="ph_late_deduction" sum="Total Late Deduction"/>
            </list>
        </field>
    </record>

    <record id="action_ph_late_attendance" model="ir.actions.act_window">
        <field name="name">Late Attendance</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_hr_attendance_ph_late_list"/>
        <field name="domain">[('ph_is_late', '=', True)]</field>
        <field name="help" type="html">
            <p>Check-ins that arrived later than the employee's assigned Work Schedule's
               grace period. The Late Deduction shown here is pulled automatically into
               that employee's next payslip covering this date.</p>
        </field>
    </record>

</odoo>

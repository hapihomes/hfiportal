<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ph_overtime_type_list" model="ir.ui.view">
        <field name="name">ph.overtime.type.list</field>
        <field name="model">ph.overtime.type</field>
        <field name="arch" type="xml">
            <list string="Overtime Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="work_entry_code"/>
                <field name="multiplier"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_ph_overtime_type_form" model="ir.ui.view">
        <field name="name">ph.overtime.type.form</field>
        <field name="model">ph.overtime.type</field>
        <field name="arch" type="xml">
            <form string="Overtime Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="work_entry_code"/>
                        <field name="multiplier"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ph_overtime_type" model="ir.actions.act_window">
        <field name="name">Overtime Types</field>
        <field name="res_model">ph.overtime.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_help">Define an overtime type</p>
            <p>Each type maps a Work Entry Type code (Employees &gt; Configuration &gt; Work Entry
               Types) to a percentage of the hourly rate, e.g. Ordinary Overtime at 125%.</p>
        </field>
    </record>

</odoo>

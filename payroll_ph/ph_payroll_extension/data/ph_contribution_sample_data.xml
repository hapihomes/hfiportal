<?xml version="1.0" encoding="utf-8"?>
<!--
    SAMPLE / PLACEHOLDER DATA ONLY.

    The brackets and rates below are simplified, illustrative figures meant
    to demonstrate the SSS / PhilHealth / HDMF configuration screens and let
    the module be tested end-to-end out of the box. They are NOT guaranteed
    to match the current official SSS Circular, PhilHealth Circular or
    Pag-IBIG (HDMF) Circular. Before running live payroll, an administrator
    must review and update these records under PH Payroll Settings to match
    the currently effective government schedules.
-->
<odoo noupdate="1">


<?xml version="1.0" encoding="utf-8"?>
<!--
    Deliberately NOT noupdate: these formulas are module-controlled (admins
    should customize rates via the SSS/PhilHealth/HDMF config tables and the
    Structure's PH Pay Policy tab, not by hand-editing rule Python code).

    NOTE: the values here are kept in sync with _PH_SALARY_RULE_FORMULAS in
    models/ph_config.py, which is the actual authoritative source: it
    force-writes these formulas on every module load (see
    _ph_fix_salary_rule_formulas), because Odoo's XML data loader won't
    overwrite a record that already existed under noupdate="1" in an
    earlier version of this module, no matter what this file says. This
    file only matters for a genuinely fresh install; if you change a
    formula, change it in both places.

    Each "inputs.CODE"/"categories.CODE" read is written using only
    try/except and literal attribute/key access (no hasattr/getattr) so it
    tolerates: a plain dict (code -> amount, or code -> input-line record),
    or the classic wrapper object (dotted attribute access), and works
    even when this build's rule sandbox doesn't expose hasattr/getattr.
-->
<odoo>

    <record id="ph_rule_basic" model="hr.salary.rule">
        <field name="name">Basic Salary</field>
        <field name="code">BASIC</field>
        <field name="sequence" eval="100"/>
        <field name="category_id" ref="ph_category_basic"/>
        <field name="struct_id" ref="ph_structure_regular_pay"/>
        <field name="amount_select">code</field>
        <!-- Proration (full wage vs. half) is computed in Python from the
             Structure's "PH Pay Frequency" setting; see hr_payslip.py. -->
        <field name="amount_python_compute">try:
    _v = inputs['BASICWAGE']
except:
    try:
        _v = inputs.BASICWAGE
    except:
        _v = 0.0
try:
    result = _v.amount
except:
    result = _v or 0.0</field>
    </record>


<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Control number format: MMYY-### (e.g. 1126-017), numbering restarts each month -->
    <record id="seq_dispatch_receipt" model="ir.sequence">
        <field name="name">Dispatch Delivery Receipt</field>
        <field name="code">dispatch.receipt</field>
        <field name="prefix">%(month)s%(y)s-</field>
        <field name="padding">3</field>
        <field name="use_date_range" eval="True"/>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
